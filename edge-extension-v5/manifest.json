{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "PriceMonitor v5 Marketplace Bridge",
  "version": "5.0.8",
  "description": "Optional manual capture of marketplace comparison pages only.",
  "key": "",
  "permissions": [
    "alarms",
    "offscreen",
    "scripting",
    "storage",
    "tabs",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*.kaina24.lt/*",
    "https://*.salidzini.lv/*",
    "https://*.hinnavaatlus.ee/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PriceMonitor Browser Bridge",
    "default_popup": "popup.html"
  }
}
