{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "PriceMonitor Browser Bridge",
  "version": "4.2.1",
  "description": "Uses your normal Edge session to return rendered retailer pages to the local PriceMonitor application.",
  "key": "",
  "permissions": ["alarms", "offscreen", "scripting", "storage", "tabs"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://www.senukai.lt/*",
    "https://www.bite.lt/*",
    "https://www.varle.lt/*",
    "https://www.elesen.lt/*",
    "https://www.elisa.ee/*",
    "https://www.euronics.ee/*",
    "https://www.rde.ee/*",
    "https://www.smartech.ee/*",
    "https://www.salidzini.lv/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PriceMonitor Browser Bridge",
    "default_popup": "popup.html"
  }
}
