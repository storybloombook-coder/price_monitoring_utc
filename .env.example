# Paths are relative to the project root unless absolute.
SOURCE_WORKBOOK=UTC price 2026 line up.xlsx
DATA_DIR=var
DATABASE_PATH=var/price_monitor.sqlite3
EXPORT_DIR=var/exports
LOG_DIR=var/logs
SCHEDULE_TIME=08:00
SCHEDULE_TIMEZONE=Europe/Riga
ENABLE_SCHEDULER=true
# Keep false until each marketplace's permitted access and parser validation are complete.
ENABLE_LIVE_MARKETPLACES=false
HTTP_TIMEOUT_SECONDS=20
GLOBAL_CONCURRENCY=3
HOST=127.0.0.1
PORT=8000
