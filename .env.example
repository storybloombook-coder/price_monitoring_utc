# Paths are relative to the project root unless absolute.
SOURCE_WORKBOOK=UTC price 2026 line up.xlsx
DATA_DIR=var
DATABASE_PATH=var/price_monitor.sqlite3
EXPORT_DIR=var/exports
LOG_DIR=var/logs
SCHEDULE_TIME=08:00
SCHEDULE_TIMEZONE=Europe/Riga
ENABLE_SCHEDULER=true
# Marketplace collection is active in v4.
ENABLE_LIVE_MARKETPLACES=true
HTTP_TIMEOUT_SECONDS=20
# Polite monitoring: one request per shop at a time, with pacing and protection cooldowns.
SHOP_REQUEST_DELAY_MIN_SECONDS=8
SHOP_REQUEST_DELAY_MAX_SECONDS=15
SHOP_COOLDOWN_SECONDS=3600
SHOP_CACHE_TTL_SECONDS=14400
# Maximum time for completing a visible retailer check through the Edge extension.
BROWSER_BRIDGE_TIMEOUT_SECONDS=150
# Assisted marketplaces (currently Salidzini): reuse success for 12 hours and pace visible tabs.
ASSISTED_MARKETPLACE_CACHE_TTL_SECONDS=43200
ASSISTED_MARKETPLACE_DELAY_SECONDS=3
GLOBAL_CONCURRENCY=1
HOST=127.0.0.1
PORT=8000
# v4 opens the application page after both services are ready.
OPEN_BROWSER=true
# The bundled v3 marketplace engine runs privately on this port.
ENABLE_LEGACY_SERVICE=true
LEGACY_PORT=8001
